# Copy this file to .env and fill in your keys. Leave a key empty to run
# without it; `demo` works with no keys at all.

# YouTube Data API v3. The free tier is 10,000 units/day.
# https://console.cloud.google.com/ -> enable "YouTube Data API v3" -> create an API key
YOUTUBE_API_KEY=

# Anthropic API, used for the extraction and clustering passes.
# https://console.anthropic.com/ (an `ant auth login` profile also works if you
# delete this line instead)
ANTHROPIC_API_KEY=

# ---- optional tuning -------------------------------------------------------

# The map pass reads every raw comment and is most of the token spend; the
# reduce pass only sees pre-aggregated statements. Both default to Opus 5.5.
# Haiku 5.5 is about 40x cheaper per token for the map pass, with some loss of
# nuance on sarcastic or oblique comments.
# NICHE_MAP_MODEL=claude-haiku-5-5
# NICHE_REDUCE_MODEL=claude-opus-5-5

# Send the map pass through the Batches API: half price, but a batch can take
# up to 24 hours.
# NICHE_USE_BATCH_API=true

# Comments per map request, and how many requests run at once.
# NICHE_BATCH_SIZE=50
# NICHE_CONCURRENCY=4
