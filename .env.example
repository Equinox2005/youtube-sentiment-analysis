# Copy this file to .env and fill in your keys.

# YouTube Data API v3 — free tier is 10,000 units/day.
# https://console.cloud.google.com/ → enable "YouTube Data API v3" → create an API key
YOUTUBE_API_KEY=your-youtube-key-here

# Anthropic API — powers the extraction and clustering passes.
# https://console.anthropic.com/  (an `ant auth login` profile also works instead)
ANTHROPIC_API_KEY=your-anthropic-key-here

# ---- optional tuning -------------------------------------------------------

# The map pass reads every raw comment and is the bulk of the token spend; the
# reduce pass sees only pre-aggregated statements. Both default to Opus 5.
# Switching the map pass to Haiku cuts its cost roughly 5x, with some loss of
# nuance on sarcastic or oblique comments.
# NICHE_MAP_MODEL=claude-haiku-4-5
# NICHE_REDUCE_MODEL=claude-opus-5

# Route the map pass through the Batches API: 50% cheaper, but it can take up
# to 24 hours. Worth it for large studies where latency does not matter.
# NICHE_USE_BATCH_API=true

# Comments per map request, parallel in-flight requests.
# NICHE_BATCH_SIZE=50
# NICHE_CONCURRENCY=4
